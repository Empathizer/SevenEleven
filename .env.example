# IMPORTANT: DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS
# Copy this to .env.local and fill with your actual values

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING_MINIMUM
JWT_EXPIRE=7d

# Environment
NODE_ENV=production

# API URL (leave empty for same domain)
NEXT_PUBLIC_API_URL=

# Email Configuration (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-secure-password
EMAIL_FROM_NAME=YourAppName
FRONTEND_URL=https://yourdomain.com

# Security Notes:
# 1. Generate strong JWT_SECRET: openssl rand -base64 32
# 2. Use strong database password (16+ chars, mixed case, numbers, symbols)
# 3. Enable 2FA on MongoDB Atlas
# 4. Use environment-specific credentials
# 5. Rotate secrets regularly
# 6. Never commit .env.local to git
